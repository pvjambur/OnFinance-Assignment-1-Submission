# Application
APP_NAME=mobile-automation-agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# BrowserStack
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key
BROWSERSTACK_HUB=https://hub-cloud.browserstack.com/wd/hub

# Supabase (FREE forever tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AI Services
# Google Gemini (FREE - 60 req/min)
GOOGLE_API_KEY=your-google-api-key

# OpenAI (FREE $5 credit)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude (Optional - FREE trial)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:latest

# Security
ENCRYPTION_KEY=generate-random-32-char-key-here
PIN_SALT=generate-random-salt-here

# Device Configuration
DEFAULT_DEVICE=Google Pixel 6
DEFAULT_PLATFORM_VERSION=12.0

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT=30
CACHE_TTL=300

# Voice
VOICE_ENABLED=true
TTS_RATE=175
STT_LANGUAGE=en-US

# Features
ENABLE_SUPABASE=true
ENABLE_REDIS=true
ENABLE_OLLAMA=false
